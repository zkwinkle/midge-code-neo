menu "midge-code-neo"

choice MIDGE_CODE_SEL_IMU
	prompt "IMU selection"
	default MIDGE_CODE_SEL_IMU_ICM20948

config MIDGE_CODE_SEL_IMU_ICM20948
	bool "ICM20948"

config MIDGE_CODE_SEL_IMU_ICM42605
	bool "ICM42605"

endchoice

config MIDGE_CODE_IMU_ICM20948_USE_CLOSED_DRIVER
	bool "Use closed-source driver for ICM20948"
	depends on MIDGE_CODE_SEL_IMU_ICM20948
	default y
	help
	  Enable to use the closed-source ICM20948 driver.
	  Disable to use the Zephyr native ICM20948 driver.

endmenu

source "Kconfig.zephyr"
